# ─────────────────────────────────────────────────────────────────────────────
# DevCrew Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://devcrew:devcrew_password@localhost:5432/devcrew
DATABASE_URL_SYNC=postgresql://devcrew:devcrew_password@localhost:5432/devcrew

# ── Model Providers ───────────────────────────────────────────────────────────
# OpenRouter — https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq (optional fast/cheap tier) — https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini (free tier) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── Model Routing ─────────────────────────────────────────────────────────────
# Primary reasoning model (used for architecture, review, security reasoning)
PRIMARY_MODEL=anthropic/claude-3-5-sonnet
PRIMARY_PROVIDER=openrouter

# Coding model (used for code generation, debugging, test generation)
CODING_MODEL=qwen/qwen2.5-coder-32b-instruct
CODING_PROVIDER=openrouter

# Fast/cheap model (used for summarization, classification, formatting)
FAST_MODEL=meta-llama/llama-3.1-8b-instruct
FAST_PROVIDER=groq

# ── ChromaDB (Vector Store) ───────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_URL=http://localhost:8001

# ── GitHub Integration ────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username

# ── Workspace ─────────────────────────────────────────────────────────────────
WORKSPACE_BASE_PATH=./workspaces
MAX_WORKSPACE_SIZE_MB=500

# ── Execution Sandbox ────────────────────────────────────────────────────────
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_OUTPUT_BYTES=1048576
ENABLE_DOCKER_SANDBOX=false

# ── Agent Limits ─────────────────────────────────────────────────────────────
MAX_ITERATIONS_PER_PROJECT=10
MAX_RETRIES_PER_AGENT=3

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_PROJECTS_PER_USER=3
